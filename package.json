{
  "name": "whats-in-my-claude",
  "version": "0.1.0",
  "description": "A local, read-only dashboard of your Claude Code setup: projects, sessions, memories, skills, plugins, MCP servers, hooks and more.",
  "keywords": [
    "claude",
    "claude-code",
    "dashboard",
    "cli",
    "mcp",
    "skills"
  ],
  "homepage": "https://github.com/srdjanrist/whats-in-my-claude#readme",
  "bugs": "https://github.com/srdjanrist/whats-in-my-claude/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srdjanrist/whats-in-my-claude.git"
  },
  "type": "module",
  "bin": {
    "whats-in-my-claude": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && bun run build:cli",
    "build:cli": "bun build server/cli.ts --target=node --format=esm --outfile=dist/cli.js",
    "start": "bun run build && node dist/cli.js",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
